{
  // Local and example configuration only. Production D1/R2 identifiers, the
  // Access team domain and audience, and every secret stay out of source
  // (docs/cms-access.md). Nothing here deploys.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repoglance-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": false,
  "preview_urls": false,
  // Cloudflare caches the Worker's own responses when they ask for it; the
  // public pages opt in (src/page-cache.ts), everything else is no-store.
  "cache": {
    "enabled": true
  },
  // The Worker's own version id, read by the Astro cache provider: a
  // version-scoped ETag and an astro-version cache tag. Not a resource.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "EMDASH_SITE_URL": "https://repoglance.com",
    // The CMS mirror (src/cms/mirror.ts): the repository it opens cms-edit
    // PRs against and the sender of its failure emails. The GitHub token is
    // a secret (GITHUB_MIRROR_TOKEN) and the recipient a deploy-time var
    // (MIRROR_EMAIL_TO, scripts/prepare-deploy.mjs); neither is in source.
    "GITHUB_MIRROR_REPO": "saari-co/repoglance-site",
    "MIRROR_EMAIL_FROM": "mirror@repoglance.com"
  },
  // Cloudflare Email Routing: the mirror's failure email. The recipient
  // comes from MIRROR_EMAIL_TO and must be a verified destination address of
  // the account; sending needs Email Routing enabled on repoglance.com.
  "send_email": [
    {
      "name": "MIRROR_EMAIL"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "repoglance-site-cms-local",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "repoglance-site-media-local"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "triggers": {
    "crons": ["0 4 * * *"]
  }
}
