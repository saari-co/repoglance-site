---
import { isScreenshotSlug, screenshots } from '../content/screenshots';

interface Props {
  slug: unknown;
  priority?: boolean;
}
const { slug, priority = false } = Astro.props;
const shot = isScreenshotSlug(slug) ? { slug, ...screenshots[slug] } : null;
---
{shot && (
  <figure class="shot" data-shot={shot.slug}>
    <img
      src={`/screenshots/${shot.slug}-540.webp`}
      srcset={`/screenshots/${shot.slug}-540.webp 540w, /screenshots/${shot.slug}-1080.webp 1080w`}
      sizes="(min-width: 760px) 320px, 70vw"
      width={shot.width}
      height={shot.height}
      alt={shot.alt}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </figure>
)}
