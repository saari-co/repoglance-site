---
import { imageConfig } from 'astro:assets';
import manifest from '../../seed/media.json';
import { RENDER_SIZES, RENDER_WIDTHS, approvedByFile, imageEndpointUrl, imageSrcset, resolveImageValue, type MediaManifest } from '../content/media';

// The image of a hero or feature block, rendered from its media reference
// (decision media-library-014): a media value from the CMS, or the seed's
// `$media` reference when the page renders from the fallback. Every width
// comes from Astro's image endpoint, which serves one source per capture.
//
// Scheme-matched imagery (site-scheme-imagery-010, design.md v5): a value
// that carries a dark variant renders as a <picture> whose image follows the
// colour scheme. 'page' shows the primary (the light cut) on the light scheme
// and the dark variant on the dark scheme; 'band' is the inverse, for the
// home hero's phone on the band that itself inverts. A value without a dark
// variant renders its primary alone. Alt text is the media item's, with the
// block's own heading as the fallback; a block whose reference is gone
// renders no figure.
interface Props {
  image: unknown;
  heading?: string;
  priority?: boolean;
  scheme?: 'page' | 'band';
}
const { image, heading = '', priority = false, scheme = 'page' } = Astro.props;
const { primary, dark } = resolveImageValue(image, approvedByFile(manifest as unknown as MediaManifest));
const route = imageConfig.endpoint.route ?? '/_image';
const policy = primary && dark ? scheme : 'single';
const onLight = policy === 'band' ? dark : primary;
const onDark = policy === 'band' ? primary : dark;
const alt = (primary?.alt ?? '').trim() || heading;
---
{primary && onLight && (
  <figure class="shot" data-shot={primary.name} data-scheme={policy}>
    <picture>
      {policy !== 'single' && onDark && <source media="(prefers-color-scheme: dark)" srcset={imageSrcset(route, onDark.href)} sizes={RENDER_SIZES} />}
      <img
        src={imageEndpointUrl(route, onLight.href, RENDER_WIDTHS[0])}
        srcset={imageSrcset(route, onLight.href)}
        sizes={RENDER_SIZES}
        width={onLight.width}
        height={onLight.height}
        alt={alt}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
      />
    </picture>
  </figure>
)}
