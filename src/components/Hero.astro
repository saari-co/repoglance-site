---
import Screenshot from './Screenshot.astro';
import { safeHref, stringField, type SeedBlock } from '../content/blocks';

interface Props { value: SeedBlock; index: number; blockKey: string }
const { value } = Astro.props;
const text = (field: string) => stringField(value, field);
const primaryHref = safeHref(value.primary_href);
const secondaryHref = safeHref(value.secondary_href);
// The home hero's phone follows the band it sits on; every other image
// follows the page (site-scheme-imagery-010, design.md v5).
const isHome = (Astro.url.pathname.replace(/\/+$/, '') || '/') === '/';
---
<div class="band band-hero">
<section class="hero" data-block="hero">
  <div>
    {text('eyebrow') && <p class="label">{text('eyebrow')}</p>}
    <h1>{text('heading')}</h1>
    <p class="lead">{text('lead')}</p>
    <div class="hero-links">
      {primaryHref && text('primary_label') && (
        <a class="button button-primary" href={primaryHref}>{text('primary_label')}</a>
      )}
      {secondaryHref && text('secondary_label') && (
        <a class="button button-secondary" href={secondaryHref}>{text('secondary_label')}</a>
      )}
    </div>
  </div>
  <Screenshot image={value.image} heading={text('heading')} priority scheme={isHome ? 'band' : 'page'} />
</section>
</div>
