---
import type { SeedBlock } from '../content/seed-fallback';

interface Props { value: SeedBlock; index: number; blockKey: string }
const { value } = Astro.props;
const text = (field: string): string => (typeof value[field] === 'string' ? (value[field] as string) : '');
interface Step { text: string; link_label?: string; link_href?: string }
const steps: Step[] = Array.isArray(value.steps)
  ? (value.steps as Array<Record<string, unknown>>)
      .filter((step) => typeof step?.text === 'string')
      .map((step) => ({
        text: step.text as string,
        link_label: typeof step.link_label === 'string' ? step.link_label : undefined,
        link_href: typeof step.link_href === 'string' ? step.link_href : undefined,
      }))
  : [];
---
<section class="steps" data-block="steps">
  <h2>{text('heading')}</h2>
  {text('intro') && <p class="intro">{text('intro')}</p>}
  <ol>
    {steps.map((step) => (
      <li>
        {step.text}
        {step.link_href && step.link_label && (
          <>
            {' '}
            <a href={step.link_href}>{step.link_label}</a>
          </>
        )}
      </li>
    ))}
  </ol>
  {text('note') && <p class="note">{text('note')}</p>}
</section>
