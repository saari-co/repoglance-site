---
import Screenshot from './Screenshot.astro';
import { stringField, type SeedBlock } from '../content/blocks';

interface Props { value: SeedBlock; index: number; blockKey: string }
const { value } = Astro.props;
const text = (field: string) => stringField(value, field);
---
<section class="feature" data-block="feature">
  <div>
    <h2>{text('heading')}</h2>
    <p>{text('body')}</p>
  </div>
  <Screenshot image={value.image} heading={text('heading')} />
</section>
