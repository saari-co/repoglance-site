---
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  contentSource?: 'cms' | 'seed' | 'none';
}
const { title, description, contentSource = 'none' } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(pathname, Astro.site ?? 'https://repoglance.com');
const ogImage = new URL('/og-image.png', canonical);
const isHome = pathname === '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RepoGlance" />
    <meta property="og:title" content={isHome ? 'RepoGlance' : `${title} · RepoGlance`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{isHome ? 'RepoGlance' : `${title} · RepoGlance`}</title>
  </head>
  <body data-content-source={contentSource}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 108 108" width="28" height="28" aria-hidden="true" focusable="false">
          <g transform="translate(25.212 25.212) scale(2.35)" fill="none" stroke="currentColor">
            <circle cx="10.1" cy="10.1" r="9" stroke-width="1" opacity=".55"/>
            <circle cx="10.1" cy="10.1" r="11" stroke-width=".8" opacity=".33"/>
            <circle cx="10.1" cy="10.1" r="6.7" stroke-width="2.5"/>
            <path d="M15.6 15.6L21.1 21.1" stroke-width="3" stroke-linecap="round"/>
            <path d="M10.1 4.3v1.4M10.1 14.5v1.4" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M5.7 10.1Q10.1 4.9 14.5 10.1Q10.1 15.3 5.7 10.1Z" stroke-width="1.6" stroke-linejoin="round"/>
            <circle cx="10.1" cy="10.1" r="1.6" stroke-width="1.6"/>
          </g>
        </svg>
        <span>RepoGlance</span>
      </a>
      <nav aria-label="Main">
        <a href="/testers">Join the test</a>
        <a href="https://github.com/saari-co/RepoGlance">Source</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <p>
        RepoGlance is an independent app by Saari. It is not affiliated with or
        endorsed by GitHub, Inc.
      </p>
      <p class="footer-links">
        <a href="https://saari-co.github.io/RepoGlance/privacy/">Privacy policy</a>
        <a href="https://github.com/saari-co/RepoGlance">App source</a>
        <a href="https://github.com/saari-co/repoglance-site">Site source</a>
      </p>
    </footer>
  </body>
</html>
